# Copy to .env and fill in. Never commit .env.

# --- Symplistic ContentIQ -------------------------------------------------
# Key: ContentIQ → Settings → ContentIQ API → Generate key.
# It is shown once, and generating a new key invalidates the old one.
CONTENTIQ_API_KEY=
CONTENTIQ_API_BASE=https://backend.contentiq.symplistic.ai

# Optional, for the curl examples. A ContentIQ agent ID is the same as its wxO agent ID
# (.venv/bin/orchestrate agents list).
# Agent holding data/ (single-project test, e.g. Project_Files):
CONTENTIQ_AGENT_ID=
# Agent holding sample_drive/Clients (e.g. Client_Drive):
CONTENTIQ_DRIVE_AGENT_ID=

# --- IBM watsonx Orchestrate (IBM Cloud) ----------------------------------
# Key: wxO → user icon → Settings → API details → Generate API key (opens IBM Cloud IAM → Create).
# Use this key, not the credentials on the IBM Cloud resources page.
WXO_API_KEY=
WXO_SERVICE_URL=https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<instance-id>
# Name of the ADK environment that scripts/deploy_wxo.sh creates or reuses
WXO_ENV=wxo

# The search tool ContentIQ created in wxO for the client-drive agent.
# Find it with: .venv/bin/orchestrate tools list -v | grep -oE 'symplisticai_tool[a-z0-9_]*' | sort -u
CONTENTIQ_WXO_TOOL=
